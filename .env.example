# =============================================================================
# IU Club Backend — template (copy thành .env rồi điền giá trị)
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3456
CLIENT_URL=http://localhost:5173
# Origin CORS thêm (cách nhau bởi dấu phẩy). Local đã tự mở 5173/4173/6666.
# CORS_ORIGINS=https://iuptit.com
# URL gốc backend khi deploy (dùng để tự suy ra GOOGLE_CALLBACK_URL).
# Local để trống = http://localhost:${PORT}. Deploy: vd https://api.yourdomain.com
BACKEND_URL=
# Số proxy hop tin cậy để rate-limit lấy đúng IP client (X-Forwarded-For).
# Local/chạy trực tiếp = 0. Sau 1 reverse proxy (nginx) hoặc PaaS = 1.
TRUST_PROXY=0

# --- Database ---
# Local: mongodb://127.0.0.1:27017/iu_club
# Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=IUCLUB
MONGODB_URI=mongodb://127.0.0.1:27017/iu_club

# --- JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Seed admin / members (npm run seed:admin | seed:real) ---
ADMIN_NAME=IU Club Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_REAL_PASSWORD=IuClub@2026

# --- Google OAuth (để trống = tắt SSO) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Để trống = tự suy ra ${BACKEND_URL}/api/v1/auth/google/callback.
# Chỉ set khi muốn override URL callback thủ công.
GOOGLE_CALLBACK_URL=

# --- Cloudinary (upload avatar / CV ứng viên) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email: ưu tiên SendGrid Web API khi deploy ---
# API Key: SendGrid → Settings → API Keys (Mail Send)
# From phải là Single Sender / Domain đã verify
SENDGRID_API_KEY=
EMAIL_FROM=IU_CLUB <iuptit.com@gmail.com>

# SMTP fallback (local — Gmail dễ bị chặn trên PaaS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IU_CLUB <iuptit.com@gmail.com>
