{
  "name": "iu-club-backend",
  "version": "1.0.0",
  "description": "IU_CLUB student club management platform — backend API (Slice 1: Foundation + Auth)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:real": "node src/scripts/cleanAndSeedReal.js",
    "seed:demo": "node src/scripts/seedDemoUsers.js",
    "seed:members": "node src/scripts/seedDemoUsers.js",
    "reset:training-demo": "node src/scripts/resetTrainingDemo.js",
    "migrate:separate-leader-mentor": "node src/scripts/separateLeaderMentorRoles.js",
    "test:training-flow": "node src/scripts/smokeTrainingFlow.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "iu-club",
    "express",
    "mongodb",
    "auth"
  ],
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "agenda": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "celebrate": "^15.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  }
}
